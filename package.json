{
  "name": "kea",
  "version": "0.1.0",
  "private": true,
  "description": "Kea: connected maternal care referral and continuity of care platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:reference": "tsx --conditions=react-server scripts/seed-reference.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test:integration": "vitest run --dir tests/integration",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "0.469.0",
    "next": "^16.4.6",
    "next-themes": "0.4.4",
    "nodemailer": "^10.5.0",
    "postgres": "3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "2.15.0",
    "server-only": "^0.0.1",
    "sonner": "1.7.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "twilio": "5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "16.4.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vitest": "^5.1.0"
  }
}
