# ---------------------------------------------------------------------------
# Kea environment configuration
#
# Copy this file to .env.local and fill in the values for your deployment.
# Never commit a filled in copy. Every value below is a placeholder: there are
# no real credentials anywhere in this repository.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string. Supabase, Neon, RDS or a self hosted instance
# all work. The application creates no extensions beyond pgcrypto, which the
# first migration enables for gen_random_uuid().
DATABASE_URL=postgresql://kea:change-me@localhost:5432/kea

# TLS mode for the database connection.
#   require  use TLS and fail if it is unavailable (use this in production)
#   prefer   use TLS when the server offers it
#   disable  plain connection (local development only)
DATABASE_SSL=prefer

# The public origin of this deployment. Used for links in emails and for the
# default Twilio status callback URL.
APP_URL=http://localhost:3000

# --- Sessions -------------------------------------------------------------

# Name of the staff session cookie.
SESSION_COOKIE_NAME=kea_session

# Staff session lifetime in hours.
SESSION_TTL_HOURS=12

# Patient portal session lifetime in minutes. Kept short deliberately.
PATIENT_SESSION_TTL_MINUTES=45

# --- Messaging, optional --------------------------------------------------
#
# Leave MESSAGING_ENABLED as false until a real sender is configured and
# tested. While it is false, messages are still recorded and queued so nothing
# is lost, and none are sent. A queued message is never reported as delivered.

MESSAGING_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# One of these is needed for SMS. A messaging service SID is preferred.
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp sender in E.164 form, without the whatsapp: prefix.
TWILIO_WHATSAPP_FROM=

# Public base URL Twilio should call back on, if it differs from APP_URL.
# The application appends /status and /inbound to it. This value must match
# the URL configured in the Twilio console exactly, because it is part of the
# signature that is verified on every webhook.
TWILIO_WEBHOOK_URL=

# --- Assisted drafting, optional -----------------------------------------
#
# Off by default. Only turn this on once your organisation has a legal basis
# and a data processing agreement covering the provider. See docs/ai.md.

AI_ASSIST_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Prediction service, optional ----------------------------------------
#
# The product works fully without this. The model shipped in this repository
# is trained on synthetic data and is not validated for patient care.

PREDICTION_ENABLED=false
PREDICTION_SERVICE_URL=http://localhost:8000
PREDICTION_SERVICE_TOKEN=

# --- Operational email, optional -----------------------------------------
#
# Used for staff invitations, password resets and pilot enquiry notifications.
# Never used for patient messages. When this is not set, an invitation link is
# shown to the administrator who created it instead of being emailed.

SMTP_URL=
SMTP_FROM="Kea <no-reply@example.org>"
PILOT_ENQUIRY_NOTIFY_EMAIL=

# --- Scheduled jobs -------------------------------------------------------
#
# Shared secret for POST /api/jobs/run. When this is not set the endpoint
# refuses every request rather than running unauthenticated. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

JOB_RUNNER_TOKEN=

# --- Logging --------------------------------------------------------------

LOG_LEVEL=info

# --- Bootstrap, used by scripts only --------------------------------------
#
# Read by `npm run admin:create`. Leave KEA_ADMIN_PASSWORD unset to have a
# strong password generated and printed once.

KEA_ADMIN_EMAIL=
KEA_ADMIN_NAME=
KEA_ADMIN_ORG=
KEA_ADMIN_PASSWORD=

# Read by `npm run seed:demo`. Leave unset to have one generated and printed.
KEA_DEMO_PASSWORD=
